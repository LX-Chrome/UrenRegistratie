[Unit]
Description=UrenRegistratie Gunicorn Service
After=network.target

[Service]
User=klundert
Group=klundert
WorkingDirectory=/home/klundert/projects/UrenRegistratie
ExecStartPre=/bin/bash -c 'mkdir -p logs static/js static/css instance'
ExecStart=/home/klundert/projects/UrenRegistratie/venv/bin/gunicorn --workers 1 --bind 0.0.0.0:8000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target 